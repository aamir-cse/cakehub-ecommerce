<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Include default Spring Boot logging patterns and color schemes -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Standard readable console logging format -->
    <property name="CONSOLE_LOG_PATTERN"
              value="%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(${LOG_LEVEL_PATTERN:-%5p}) %clr(${PID:- }){magenta} %clr(---){faint} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}"/>

    <!-- Console Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Rolling Daily & Size-based File Appender -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/cakehub.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- Daily rollover directory and file pattern -->
            <fileNamePattern>logs/archived/cakehub-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <!-- Max file size before rolling into a new index -->
            <maxFileSize>10MB</maxFileSize>
            <!-- Retain logs up to 30 days -->
            <maxHistory>30</maxHistory>
            <!-- Hard ceiling on overall archived log storage -->
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Package-level log granularity -->
    <!-- Detailed debug logs for CakeHub application components -->
    <logger name="com.cakehub" level="DEBUG"/>
    <!-- Web dispatcher and security logs -->
    <logger name="org.springframework.web" level="INFO"/>
    <logger name="org.springframework.security" level="INFO"/>
    <!-- SQL query logging for database visibility -->
    <logger name="org.hibernate.SQL" level="DEBUG"/>

    <!-- Root logging levels attaching both console and disk file output -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>